# ============================================================
# BACKEND — VARIÁVEIS DE AMBIENTE
# ============================================================

# Ambiente
NODE_ENV=production
PORT=3001

# Banco de dados (Railway PostgreSQL Plugin gera automaticamente)
DATABASE_URL=postgresql://user:pass@host:5432/sexshop_db

# URLs
FRONTEND_URL=https://seu-frontend.railway.app
API_URL=https://sua-api.railway.app

# JWT — use strings aleatórias com mínimo 32 caracteres
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=seu_jwt_secret_super_seguro_minimo_32_chars_aqui
JWT_REFRESH_SECRET=seu_refresh_secret_diferente_minimo_32_chars_aqui
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Criptografia AES-256 — EXATAMENTE 32 caracteres
ENCRYPTION_KEY=chave_aes_256_exatamente_32_chars

# ============================================================
# STRIPE (Cartão de Crédito/Débito)
# ============================================================
STRIPE_SECRET_KEY=sk_live_sua_chave_secreta_stripe
STRIPE_PUBLISHABLE_KEY=pk_live_sua_chave_publica_stripe
STRIPE_WEBHOOK_SECRET=whsec_seu_webhook_secret_stripe

# ============================================================
# MERCADO PAGO (PIX)
# ============================================================
MP_ACCESS_TOKEN=APP_USR-seu_access_token_mercado_pago
MP_PUBLIC_KEY=APP_USR-sua_public_key_mercado_pago
MP_WEBHOOK_URL=https://sua-api.railway.app/api/payments/webhook/mercadopago

# ============================================================
# CLOUDINARY (Upload de imagens)
# ============================================================
CLOUDINARY_CLOUD_NAME=seu_cloud_name
CLOUDINARY_API_KEY=sua_api_key_cloudinary
CLOUDINARY_API_SECRET=seu_api_secret_cloudinary

# ============================================================
# E-MAIL (SMTP)
# ============================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=seuemail@gmail.com
# Para Gmail: gere uma App Password em myaccount.google.com/apppasswords
SMTP_PASS=sua_app_password_16_chars
EMAIL_FROM="Minha Sexy Shop <noreply@sualoja.com.br>"

# ============================================================
# FRONTEND — VARIÁVEIS DE AMBIENTE (prefixo NEXT_PUBLIC_)
# ============================================================
NEXT_PUBLIC_API_URL=https://sua-api.railway.app
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_sua_chave_publica_stripe
NEXT_PUBLIC_MP_PUBLIC_KEY=APP_USR-sua_public_key_mercado_pago
NEXT_PUBLIC_STORE_NAME=Minha Sexy Shop
NEXT_PUBLIC_STORE_URL=https://seu-frontend.railway.app
