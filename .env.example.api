# ============================================================
# Variáveis de Ambiente — API (apps/api)
# Copie este arquivo para .env na pasta apps/api para desenvolvimento local
# No Railway, configure estas variáveis no painel do serviço API
# ============================================================

# Banco de dados PostgreSQL (fornecido automaticamente pelo Railway se usar o plugin)
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# Ambiente
NODE_ENV=production
PORT=3001

# URL do frontend (URL pública do serviço Web no Railway)
FRONTEND_URL=https://seu-projeto-web.up.railway.app

# URL da própria API (opcional)
# API_URL=https://seu-projeto-api.up.railway.app

# JWT — gere com: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=sua_chave_jwt_de_pelo_menos_32_caracteres_aqui_xxxxxxxxxxxxxxxxxx
JWT_REFRESH_SECRET=sua_chave_refresh_jwt_de_pelo_menos_32_caracteres_xxxxxxxxxx
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Chave de criptografia — exatamente 32 caracteres
# gere com: node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
ENCRYPTION_KEY=12345678901234567890123456789012

# Stripe (opcional — deixe em branco se não usar)
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxx

# MercadoPago (opcional — deixe em branco se não usar)
MP_ACCESS_TOKEN=TEST-xxxxxxxxxxxxxxxx
MP_PUBLIC_KEY=TEST-xxxxxxxxxxxxxxxx
# MP_WEBHOOK_URL=https://seu-projeto-api.up.railway.app/api/payments/webhook/mp

# Cloudinary (opcional — necessário para upload de imagens)
CLOUDINARY_CLOUD_NAME=seu_cloud_name
CLOUDINARY_API_KEY=sua_api_key
CLOUDINARY_API_SECRET=seu_api_secret

# SMTP — Email (opcional — necessário para envio de emails)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=seu@email.com
SMTP_PASS=sua_senha_de_app
EMAIL_FROM="Minha Sexy Shop <noreply@sualoja.com.br>"
