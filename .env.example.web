# ============================================================
# Variáveis de Ambiente — Web (apps/web)
# Copie este arquivo para .env.local na pasta apps/web para desenvolvimento local
# No Railway, configure estas variáveis no painel do serviço Web
# ============================================================

# URL pública da API (URL do serviço API no Railway)
NEXT_PUBLIC_API_URL=https://seu-projeto-api.up.railway.app

# Stripe (opcional — mesma chave pública do painel Stripe)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxx

# MercadoPago (opcional)
NEXT_PUBLIC_MP_PUBLIC_KEY=TEST-xxxxxxxxxxxxxxxx

# Nome da loja (aparece no título e meta)
NEXT_PUBLIC_STORE_NAME=Minha Sexy Shop

# Ambiente
NODE_ENV=production
PORT=3000
