# Na raiz do projeto
cat > .gitignore << 'EOF'
# Dependencies
node_modules/
.pnp
.pnp.js

# Build outputs
.next/
dist/
build/
out/

# Environment variables (NUNCA suba esses arquivos)
.env
.env.local
.env.production
.env.*.local

# Logs
logs/
*.log
npm-debug.log*

# Prisma
prisma/migrations/

# OS files
.DS_Store
Thumbs.db

# IDE
.vscode/settings.json
.idea/

# Testing
coverage/

# Turbo
.turbo/
EOF
